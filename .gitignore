# ---- 模型权重与二进制产物（体积大，不进 GitHub，模型请走 Hugging Face）----
*.safetensors
*.pt
*.pth
*.gguf
*.bin
*.npy
*.npz
*.o
*.obj
*.lib
*.exe
*.dll

# ---- 训练数据一律不入主仓库（数据集随 Release 的 zip 发布）----
data/
v2/data/

# ---- 训练检查点里重复保存的 tokenizer 副本 ----
# v4.0 起 v2/ 已删除，训练用的分词器跟着模型目录走（v4/base/tokenizer.json），
# 它属于模型产物、不入库；训练脚本用 AutoTokenizer.from_pretrained(<模型目录>) 取它。
tokenizer.json

# ---- 构建与导出目录 ----
esp32s3-feng-llm/build/
# 板端模型导出目录（可由 tools/export_model.py 从权重复现，不入库）
esp32s3-feng-llm/model_export_*/
__pycache__/
*.pyc

# ---- 编辑器本地配置与代码提示数据（v4.0 起）----
# .vscode/ 是**每台机器自己的**：settings.json 里写了本机绝对路径
# （Python 解释器、交叉编译器的 --query-driver），换机器就得改，所以不入库。
.vscode/
# clangd / C/C++ 扩展的逐文件解析数据，由 tools/gen_compile_commands.py 从
# ESP-IDF 的构建产物 + 四组手工条目合并生成（0.2 MB）。它随时能重建，
# 且用户之间的构建路径不同，不入库。
compile_commands.json

# ---- 日志里的大文件 ----
logs/teacher_server.log
# 批量评测的临时输出（正式结果在 eval/）
logs/longctx32_*.json
# 教师服务（ninfer）的 stderr 原始输出：跟着生成一直涨（v4.0 那次从 1 MB 涨到 16 MB），
# 内容基本是每请求几行的 INFO，没有留存价值。入库的是脚本整理的 .txt 与汇总 .log，
# 这一类只留本地。（历史上已入库的几个小 err.log 是调参记录，保持原样。）
logs/*.err.log

# ---- 机器本地路径配置（每台机器不同，不入库）----
scripts/local_paths.json

# ---- coder-auditor 运行时状态（任务文件 / 失败日志 / 验证输出）----
.Codex/

# ---- 手机端（phone/） ----
# 源码（engine/*.c、cli/*.c、android/**）要入库；构建产物不入库。
# 注意 *.o / *.exe 规则**盖不住无扩展名的可执行文件**（phone_chat、
# pc_kv_suite_phone 等），必须显式排除整个 build 目录，否则会推上去一堆二进制。
phone/cli/build/
phone/cli/build-*/
phone/android/app/build/
phone/android/build/
phone/android/.gradle/
phone/android/local.properties
# AGP 原生构建缓存（externalNativeBuild 生成，含 CMake 探测结果，体积不小）
phone/android/app/.cxx/
# 打进 APK 的模型副本（由 phone/tools/build_apk.ps1 从模型目录拷入）
phone/android/app/src/main/assets/*.bin
