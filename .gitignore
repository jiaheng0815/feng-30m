# ---- 模型权重与二进制产物（体积大，不进 GitHub，模型请走 Hugging Face）----
*.safetensors
*.pt
*.pth
*.gguf
*.bin
*.npy
*.npz
*.o
*.obj
*.lib
*.exe
*.dll

# ---- 训练数据一律不入主仓库（数据集随 Release 的 zip 发布）----
data/
v2/data/

# ---- 训练检查点里重复保存的 tokenizer 副本 ----
# v4.0 起 v2/ 已删除，训练用的分词器跟着模型目录走（v4/base/tokenizer.json），
# 它属于模型产物、不入库；训练脚本用 AutoTokenizer.from_pretrained(<模型目录>) 取它。
tokenizer.json

# ---- v4/ 下的训练产物目录 ----
# 只保留训练起点 `v4/base/`（它自带 config/tokenizer/模型卡，是 4.0 的 SFT 入口）。
# 其余 `v4/<阶段>/` 是本机训练输出：权重已被 *.safetensors 挡住，但 config.json /
# tokenizer_config.json / chat_template.jinja 这几个小文件挡不住，一堆子目录加起来
# 几十份重复配置——删掉这些规则会让每次训练都往仓库里扔一坨副本。
v4/sft*
v4/retr_sft*
v4/patch_name*
v4/qat_*
v4/soup*

# ---- Release 打包输出（tools/make_release.py）----
# 四个 zip 加起来 ~140 MB，其中 PC 包 118 MB —— **主仓库只放代码与文档**，
# 而且 Gitee 单文件上限 100 MB，推上去会被 pre-receive hook 直接拒。
# 2026-10-17 就因为漏了这条，`git add -A` 把 dist/ 带进了提交。
dist/

# ---- 构建与导出目录 ----
# v4.0 目录重构前的旧路径：源码已迁到 core/ board/ pc/，本机这一坨只剩构建产物
# （IDF build/ 148 MB + pc/*.obj）。留着兼容还没重建的机器，别让它们进仓库。
esp32s3-feng-llm/
board/build/
board/build*/
# 板端模型导出目录（可由 tools/export_model.py 从权重复现，不入库）
board/model_export_*/
__pycache__/
*.pyc

# ---- 编辑器本地配置与代码提示数据（v4.0 起）----
# .vscode/ 是**每台机器自己的**：settings.json 里写了本机绝对路径
# （Python 解释器、交叉编译器的 --query-driver），换机器就得改，所以不入库。
.vscode/
# clangd / C/C++ 扩展的逐文件解析数据，由 tools/gen_compile_commands.py 从
# ESP-IDF 的构建产物 + 四组手工条目合并生成（0.2 MB）。它随时能重建，
# 且用户之间的构建路径不同，不入库。
compile_commands.json

# ---- 日志里的大文件 ----
logs/teacher_server.log
# 批量评测的临时输出（正式结果在 eval/）
logs/longctx32_*.json
# 教师服务（ninfer）的 stderr 原始输出：跟着生成一直涨（v4.0 那次从 1 MB 涨到 16 MB），
# 内容基本是每请求几行的 INFO，没有留存价值。入库的是脚本整理的 .txt 与汇总 .log，
# 这一类只留本地。（历史上已入库的几个小 err.log 是调参记录，保持原样。）
logs/*.err.log

# ---- 机器本地路径配置（每台机器不同，不入库）----
scripts/local_paths.json

# ---- 一键发布脚本（**内嵌魔搭令牌，绝不可入库**）----
# 代码推 GitHub+Gitee、模型传 Hugging Face+ModelScope，一条命令跑完。
# 之所以整份排除而不是只排除令牌：它同时写死了本机代理端口、发布用的仓库名，
# 换机器本来就要改；公开仓库里多一份带令牌的文件只会增加误提交的机会。
# 想开源这个脚本的话：把令牌挪到 scripts/local_paths.json 的 modelscope_token
# 键（同样 gitignore），脚本会自动优先读它，然后就可以把本行删掉。
tools/publish_all.py

# ---- coder-auditor 运行时状态（任务文件 / 失败日志 / 验证输出）----
.Codex/

# ---- 手机端（phone/） ----
# 源码（engine/*.c、cli/*.c、android/**）要入库；构建产物不入库。
# 注意 *.o / *.exe 规则**盖不住无扩展名的可执行文件**（phone_chat、
# pc_kv_suite_phone 等），必须显式排除整个 build 目录，否则会推上去一堆二进制。
phone/cli/build/
phone/cli/build-*/
# 真机交叉编译产物（NDK / Termux 变体：build_android、build_android_32k…）
phone/cli/build_android*/
# 长文验收的预 tokenized id 文件（由 scripts/make_longctx_ids.py 生成）
eval/longctx_ids/
# 一次性训练试验（权重/checkpoint 不入库；结论写进 CHANGELOG/eval）
v4/qat32k_trial/
v4/qat32k_smoke/
v4/base_v319b6_deq/
v4/base_4.0B_deq/
v4/base_4.0C_deq/
v4/4.0-20261018A/
v4/4.0-20261018B/
v4/4.0-20261018C/
v4/4.0-20261018D/
# 三值实验（ternary 分支）的本机产物
v4/ternary_*/
# 板端 hybrid 候选（B + v3.19 embedding）
v4/hybrid_*/
# 已删除的 moe 实验分支留下的本机产物
v4/moe_*/
phone/android/app/build/
phone/android/build/
phone/android/.gradle/
phone/android/local.properties
# AGP 原生构建缓存（externalNativeBuild 生成，含 CMake 探测结果，体积不小）
phone/android/app/.cxx/
# 打进 APK 的模型副本（由 phone/tools/build_apk.ps1 从模型目录拷入）
phone/android/app/src/main/assets/*.bin
